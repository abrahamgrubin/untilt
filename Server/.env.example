# Server
PORT=8080
NODE_ENV=development

# AWS Cognito (auth)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1

# Anthropic (Compass conversations + crisis classifier + summarization)
ANTHROPIC_API_KEY=

# Voyage AI (journal entry embeddings for pgvector retrieval)
VOYAGE_API_KEY=

# Postgres (RDS in prod; any local Postgres 15+ with the pgvector extension for dev)
DATABASE_URL=postgres://user:password@localhost:5432/untilt

# Server
PORT=8080
NODE_ENV=development

# Supabase Auth — project URL from Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Only if the project still uses the legacy JWT secret (HS256). Leave unset
# for asymmetric signing keys.
# SUPABASE_JWT_SECRET=
# Secret key (Project Settings → API Keys → secret). Server-only; enables
# account deletion. DELETE /account returns 503 without it.
SUPABASE_SECRET_KEY=

# Anthropic (Compass conversations + crisis classifier + summarization)
ANTHROPIC_API_KEY=

# Voyage AI (journal entry embeddings for pgvector retrieval)
VOYAGE_API_KEY=

# Postgres with pgvector.
# Local:  postgres://localhost:5432/untilt
# Hosted: Supabase → Connect → Session pooler (port 5432, IPv4), with DB_SSL=true
DATABASE_URL=postgres://localhost:5432/untilt
DB_SSL=false
# DB_SSL_CA_FILE=certs/supabase-ca.crt
